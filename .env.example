# PromiseDecay — environment configuration
#
# Copy to `.env` at the repository root and fill in real values.
# `.env` is gitignored and must never be committed.
#
# Nothing here is optional. The API validates this file at boot and exits with a clear
# error naming the missing key, rather than starting in a half-configured state.

# --- Runtime ----------------------------------------------------------------------
NODE_ENV=production

# --- Services ---------------------------------------------------------------------
# Public origin of the web app. Used for CORS and absolute URLs.
WEB_ORIGIN=https://promisedecay.bydx.fun
# Public origin of the API.
API_ORIGIN=https://promisedecay.bydx.fun
# Loopback port the API binds. nginx proxies /api and /health to this.
# Pick a port that is free on your host — a stale socket can hold one even when no
# process appears to own it.
API_PORT=4182
API_HOST=127.0.0.1

# --- Database ---------------------------------------------------------------------
# PromiseDecay owns a dedicated database; it never shares credentials with another app.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/promisedecay
DATABASE_POOL_MAX=10

# --- GenLayer ---------------------------------------------------------------------
# Public Studio RPC. See docs/DEPLOYMENT.md for running against a local node.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_NETWORK=studionet
# The deployed PromiseDecay contract. This is a PUBLIC address, not a secret.
GENLAYER_CONTRACT_ADDRESS=0x742210deAab5d1A45F68675b1Ed0be2f621671c5
GENLAYER_EXPLORER_API=https://studio.genlayer.com/api

# --- Indexer ----------------------------------------------------------------------
# How often the indexer starts a sync pass. A pass is paced against the node's rate limit,
# so this is a floor between passes, not a guarantee of freshness.
# The indexer derives its own interval from the request budget and the promise count,
# because a fixed interval cannot be correct as the dataset grows.
INDEXER_DAILY_REQUEST_BUDGET=2500
INDEXER_MIN_INTERVAL_MS=600000
INDEXER_ENABLED=true

# --- Observability -----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Rate limiting (API) -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Pagination --------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Frontend (public) -------------------------------------------------------------
# These are embedded into the client bundle and are therefore PUBLIC. Never put a secret
# in a VITE_* variable — anything prefixed VITE_ is shipped to every visitor.
VITE_API_URL=https://promisedecay.bydx.fun
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_CONTRACT_ADDRESS=0x742210deAab5d1A45F68675b1Ed0be2f621671c5
VITE_GENLAYER_NETWORK=studionet
VITE_WEB_ORIGIN=https://promisedecay.bydx.fun

# --- Optional: WalletConnect -------------------------------------------------------
# PromiseDecay works with any injected EIP-1193 wallet and needs NO WalletConnect project
# ID. Leave this unset to run injected-wallet-only; browsers without an injected wallet
# will simply see the "install a wallet" guidance. Do not invent a placeholder ID — a
# wrong ID produces a confusing connection failure rather than an honest absence.
# VITE_WALLETCONNECT_PROJECT_ID=
