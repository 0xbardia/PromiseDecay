{
  "name": "@promisedecay/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@promisedecay/config": "workspace:*",
    "@promisedecay/domain": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.0",
    "genlayer-js": "^1.1.8",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./db": {
      "types": "./dist/db/client.d.ts",
      "import": "./dist/db/client.js",
      "default": "./dist/db/client.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js",
      "default": "./dist/db/schema.js"
    },
    "./db/migrate": {
      "types": "./dist/db/migrate.d.ts",
      "import": "./dist/db/migrate.js",
      "default": "./dist/db/migrate.js"
    },
    "./chain/reader": {
      "types": "./dist/chain/reader.d.ts",
      "import": "./dist/chain/reader.js",
      "default": "./dist/chain/reader.js"
    },
    "./indexer/sync": {
      "types": "./dist/indexer/sync.d.ts",
      "import": "./dist/indexer/sync.js",
      "default": "./dist/indexer/sync.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "./dist/main.d.ts"
}
